# FDA Cyber Control — Standalone Mode
# Copy to `.env` and fill in your own values:  cp .env.example .env
#
# `.env` is git-ignored on purpose - it holds credentials. Never commit it.

# --- Server Configuration ---
FDA_PORT=8000
FDA_HOST=0.0.0.0

# --- NVIDIA API (for LLM-powered features) ---
# Get your key at: https://integrate.api.nvidia.com/
# Default model benchmarked for the triage hot path: valid strict-JSON verdicts
# in ~6s with no reasoning leakage. Reasoning models (nemotron-3.5-lightning,
# the *-flash pair) exceed 60s or leak chain-of-thought — not recommended.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# --- Frontend Build ---
# NEXT_PUBLIC_API_URL is only needed if running frontend dev server separately
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Data Retention ---
# Raw events older than this window (hours) are pruned automatically
RETENTION_HOURS=24

# --- Response Safety ---
# Dry-run is the safe default: decisions are recorded, nothing is enforced.
# Set to "false" to enable live nftables/account enforcement.
FDA_RESPONSE_DRY_RUN=true
# Enforcement TTL in seconds (auto-rollback after expiry)
FDA_RESPONSE_TTL_SECONDS=1800
# Response engine loop: cycle interval, alerts per cycle, min AI confidence to act
FDA_RESPONSE_INTERVAL_SECONDS=10
FDA_RESPONSE_MAX_ALERTS=10
FDA_RESPONSE_MIN_CONFIDENCE=0.5
# Auto-execution is controlled by the response policy, not an env var:
#   PUT /api/response/policy  {"auto_execute": true, "engines": {"<engine>": true}}
# Default: auto_execute=false — every action is held for operator review.

# --- Capture Detection Tuning (all optional; defaults fit a small LAN) ---
# Port scan (T1046)
# FDA_SCAN_WINDOW_SEC=60          # sliding window for distinct-port counting
# FDA_SCAN_PORT_THRESHOLD=20      # distinct TCP dst ports in window => scan
# FDA_SCAN_BURST_SEC=15           # ports must be touched within this burst
# FDA_SCAN_COOLDOWN_SEC=300       # min seconds between alerts for the same source
# FDA_SCAN_SUPPRESS_LOOPBACK=true # loopback chatter is not reconnaissance
# SSH brute force (T1110)
# FDA_BRUTE_WINDOW_SEC=120
# FDA_BRUTE_THRESHOLD=15          # SYN attempts to port 22 => brute force
# SYN flood (T1498)
# FDA_FLOOD_WINDOW_SEC=10
# FDA_FLOOD_THRESHOLD=100         # SYNs to one port within window
# C2 beaconing (T1071)
# FDA_BEACON_WINDOW_SEC=600
# FDA_BEACON_MIN_CONNECTIONS=8    # SYNs per flow inside the window
# FDA_BEACON_MAX_JITTER=0.25      # lower = stricter regularity requirement
# Data exfiltration (T1041)
# FDA_EXFIL_WINDOW_SEC=60
# FDA_EXFIL_BYTES_THRESHOLD=100000000  # bytes per flow per window (100 MB)

# --- Rule engine (multi-platform rule evaluation over captured events) ---
# Compiles sigma/elastic/wazuh/panther rules from the indexed catalog and
# evaluates every captured event against them; matches fire rule-cited alerts.
# FDA_RULE_ENGINE_BATCH=200          # events evaluated per detection pass
# FDA_RULE_ENGINE_MAX_ALERTS=25      # alert cap per pass (noise guard)
# FDA_RULE_ENGINE_RELOAD_SEC=300     # catalog recompile interval
# FDA_RULE_ENGINE_COOLDOWN_SEC=900   # per-rule alert cooldown

# --- Honeypot (only used in Docker compose deployments) ---
# In standalone mode, honeypot containers are not deployed.
# These vars are kept for reference if you later switch to compose:
# HONEYPOT_TTL_SECONDS=900
# HONEYPOT_BIND_ADDRESS=127.0.0.1
