__pycache__/
*.pyc
*.pyo
*.pyd
.DS_Store

# Local credentials - never commit.
.env
.env.local
.env.*.local
!.env.example

# Python tooling.
.venv/
.venv*
venv/
*.egg-info/

# Test / tool caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local runtime scratch (zeroclaw binary/config placeholders etc.).
# The directories are committed via .gitkeep so the compose bind mounts always
# have a host-owned source instead of Docker creating root-owned ones.
.runtime/*
!.runtime/.gitkeep
!.runtime/zeroclaw-bin/
!.runtime/zeroclaw-home/
.runtime/zeroclaw-bin/*
.runtime/zeroclaw-home/*
!.runtime/zeroclaw-bin/.gitkeep
!.runtime/zeroclaw-home/.gitkeep

# Runtime state - databases, logs, and scratch. Never commit.
state/*.sqlite
state/*.sqlite-*
state/logs/*
!state/logs/.gitkeep
state/logstash/*
!state/logstash/.gitkeep
state/response/*
!state/response/.gitkeep
state/orchestration/*
!state/orchestration/.gitkeep
state/demo_runs/*
state/honeypot/*
!state/honeypot/.gitkeep
logs/
pcap/

# Logstash sincedb / queue files are container-local bookkeeping.
*.sincedb
*.sincedb.*

# Large local binaries.
*.AppImage

ingest/auditd/*
!ingest/auditd/.gitkeep
ingest/json/*
!ingest/json/.gitkeep
ingest/syslog/*
!ingest/syslog/.gitkeep
ingest/pcap/*
!ingest/pcap/.gitkeep
ingest/suricata/*
!ingest/suricata/.gitkeep

# Compiled / bundled agent binary.
agent/fda-agent

# Accidentally captured host home-dir files.
home/

# Docker / ephemeral data.
docker-data/

# Vendored detection corpora and cloned playbooks (mounted at runtime).
detection-rules/
sigma/
wazuh/
panther-analysis/
vendor/
zeroclaw/hands/*/context.json

# Frontend build output.
frontend/.next/
frontend/out/
frontend/dist/
frontend/coverage/
frontend/*.log